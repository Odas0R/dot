#!/usr/bin/env bash
set -euo pipefail

PI_SRC="${DOT:-$HOME/github.com/odas0r/dot}/pi"
PI_HOME="$HOME/.pi/agent"

link_path() {
  local source=$1 target=$2

  if [[ -L "$target" ]]; then
    [[ "$(readlink "$target")" == "$source" ]] && return
    rm "$target"
  elif [[ -e "$target" ]]; then
    echo "Refusing to replace non-symlink: $target" >&2
    return 1
  fi

  ln -s "$source" "$target"
}

mkdir -p "$PI_HOME/sessions"

for package in "$PI_SRC"/extensions/*/package.json; do
  [[ -f "$package" ]] || continue
  npm install --omit=dev --omit=peer --no-audit --no-fund \
    --prefix "$(dirname "$package")"
done

for resource in extensions prompts skills themes; do
  source="$PI_SRC/$resource"
  target="$PI_HOME/$resource"

  [[ -d "$source" ]] || {
    echo "Missing Pi resource directory: $source" >&2
    exit 1
  }

  link_path "$source" "$target"
done

link_path "$PI_SRC/settings.json" "$PI_HOME/settings.json"

if [[ ! -f "$PI_HOME/auth.json" ]]; then
  install -m 600 "$PI_SRC/auth.sample.json" "$PI_HOME/auth.json"
  echo "  → Created ~/.pi/agent/auth.json from sample — please add your API keys"
fi

echo "Pi setup done! 🌟"
