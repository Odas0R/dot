#!/usr/bin/env bash
set -euo pipefail

PI_SRC="${DOT:-$HOME/github.com/odas0r/dot}/pi"
PI_HOME="$HOME/.pi/agent"

mkdir -p "$PI_HOME"/{extensions,prompts,sessions,themes}

link_files() {
  local destination=$1 source
  shift

  for source in "$@"; do
    [[ -f "$source" ]] || continue
    ln -sfn "$source" "$destination/$(basename "$source")"
  done
}

link_files "$PI_HOME/themes" "$PI_SRC/themes"/*.json
link_files "$PI_HOME/prompts" "$PI_SRC/prompts"/*.md

# Pi discovers extension directories through index.js. Keep shared helpers beside them.
for source in "$PI_SRC/extensions"/*; do
  name=$(basename "$source")
  [[ -f "$source/index.js" || "$name" == shared ]] || continue
  if [[ -f "$source/package.json" ]]; then
    npm install --omit=dev --omit=peer --no-audit --no-fund --prefix "$source"
  fi
  ln -sfn "$source" "$PI_HOME/extensions/$name"
done

# Remove symlinks from the previous flat layout and lib helper directory.
for name in pi-branch-out.js pi-review.js lib; do
  link="$PI_HOME/extensions/$name"
  [[ -L "$link" && "$(readlink "$link")" == "$PI_SRC/extensions/$name" ]] && rm "$link"
done

if [[ ! -e "$PI_HOME/settings.json" && ! -L "$PI_HOME/settings.json" ]]; then
  ln -s "$PI_SRC/settings.json" "$PI_HOME/settings.json"
  echo "  → Created symlink for pi settings"
fi

if [[ ! -f "$PI_HOME/auth.json" ]]; then
  install -m 600 "$PI_SRC/auth.sample.json" "$PI_HOME/auth.json"
  echo "  → Created ~/.pi/agent/auth.json from sample — please add your API keys"
fi

echo "Pi setup done! 🌟"
