#!/usr/bin/env bash

set -euo pipefail

format=base64url

if [[ "${1:-}" == "--hex" ]]; then
  format=hex
  shift
fi

bytes=${1:-32}

[[ $# -le 1 && "$bytes" =~ ^[1-9][0-9]*$ ]] || {
  echo "usage: secret [--hex] [bytes]" >&2
  exit 2
}

case "$format" in
  hex)
    openssl rand -hex "$bytes"
    ;;
  base64url)
    openssl rand "$bytes" \
      | base64 \
      | tr '+/' '-_' \
      | tr -d '=\n'
    ;;
esac
