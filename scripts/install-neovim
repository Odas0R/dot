#!/usr/bin/env bash

set -euo pipefail

cd /tmp

repo_dir=/tmp/neovim

if [[ -d "$repo_dir/.git" ]]; then
  git -C "$repo_dir" pull --ff-only
else
  if [[ -e "$repo_dir" ]]; then
    echo "$repo_dir exists but is not a git checkout; removing it."
    rm -rf "$repo_dir"
  fi

  git clone https://github.com/neovim/neovim "$repo_dir"
fi

cd "$repo_dir" && make CMAKE_BUILD_TYPE=RelWithDebInfo

sudo make install

echo "Done! Run 'nvim' to start neovim."
echo "nvim is installed at $(which nvim)"
